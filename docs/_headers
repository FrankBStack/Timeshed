# Cloudflare Pages headers. The wasm and the bundle sit under content-hashed
# paths, so they can be cached for a year; the pages that name them are short-lived.
/pkg/*
  Cache-Control: public, max-age=31536000, immutable
/bundle/*
  Cache-Control: public, max-age=31536000, immutable
/data/*
  Cache-Control: public, max-age=86400
/*.html
  Cache-Control: public, max-age=300
/app.js
  Cache-Control: public, max-age=300
/worker.js
  Cache-Control: public, max-age=300
/style.css
  Cache-Control: public, max-age=300
