# Cloudflare Pages headers. Everything is short-lived by default so a redeploy
# takes effect within minutes; the wasm and the bundle sit under content-hashed
# paths and can be cached for a year. Later, more specific rules win.
/*
  Cache-Control: public, max-age=300
/data/*
  Cache-Control: public, max-age=86400
/figures/*
  Cache-Control: public, max-age=86400
/pkg/*
  Cache-Control: public, max-age=31536000, immutable
/bundle/*
  Cache-Control: public, max-age=31536000, immutable
