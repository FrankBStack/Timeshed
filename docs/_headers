# Cloudflare Pages headers. Pages are short-lived so a deploy takes effect within
# minutes; everything they reference lives under a content-hashed path and is
# cached for a year. A later rule appends rather than replaces, so the general
# Cache-Control is detached (!) before the specific one is set.
/*
  Cache-Control: public, max-age=300
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/pkg/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/bundle/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/data/*
  ! Cache-Control
  Cache-Control: public, max-age=86400
/figures/*
  ! Cache-Control
  Cache-Control: public, max-age=86400
